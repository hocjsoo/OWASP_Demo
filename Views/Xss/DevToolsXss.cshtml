@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Chrome DevTools - Application & Console Inspection (Stored XSS)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; background: #202124; color: #e8eaed; overflow: hidden; height: 100vh; }
        .chrome-frame { display: flex; flex-direction: column; height: 100vh; }
        .chrome-tabs { background: #1f1f1f; display: flex; align-items: center; padding: 8px 12px 0; gap: 6px; }
        .chrome-tab { background: #292a2d; color: #fff; padding: 6px 14px; border-radius: 8px 8px 0 0; font-size: 12px; display: flex; align-items: center; gap: 6px; }
        .chrome-address-bar { background: #292a2d; padding: 6px 16px; display: flex; align-items: center; gap: 10px; font-size: 13px; color: #9aa0a6; border-bottom: 1px solid #3c4043; }
        .address-input { background: #1f1f1f; color: #fff; padding: 4px 12px; border-radius: 20px; flex: 1; border: 1px solid #3c4043; font-family: monospace; }
        .split-container { display: flex; flex: 1; height: calc(100vh - 80px); }
        .app-pane { width: 50%; border-right: 2px solid #3c4043; background: #f8f9fa; color: #212529; overflow-y: auto; padding: 20px; }
        .devtools-pane { width: 50%; display: flex; flex-direction: column; background: #202124; }
        .dt-header { background: #292a2d; display: flex; border-bottom: 1px solid #3c4043; font-size: 12px; }
        .dt-tab { padding: 8px 14px; color: #9aa0a6; cursor: pointer; border-bottom: 2px solid transparent; }
        .dt-tab.active { color: #8ab4f8; border-bottom: 2px solid #8ab4f8; font-weight: bold; background: #202124; }
        .dt-details { flex: 1; background: #202124; padding: 12px; overflow-y: auto; font-family: monospace; font-size: 12px; }
        .dt-table { width: 100%; border-collapse: collapse; font-size: 11px; font-family: monospace; margin-bottom: 12px; }
        .dt-table th { background: #292a2d; color: #9aa0a6; text-align: left; padding: 6px 8px; border-bottom: 1px solid #3c4043; }
        .dt-table td { padding: 6px 8px; border-bottom: 1px solid #292a2d; color: #e8eaed; }
        .dt-table tr.highlight { background: #3c1e22; }
        .console-line { font-family: monospace; font-size: 11.5px; padding: 4px 0; border-bottom: 1px solid #292a2d; }
        .console-prompt { color: #8ab4f8; }
        .console-output { color: #f28b82; font-weight: bold; word-break: break-all; }
    </style>
</head>
<body>
    <div class="chrome-frame">
        <div class="chrome-tabs">
            <div class="chrome-tab">💬 Stored XSS Demo (HOU) &bull; DevTools</div>
        </div>
        <div class="chrome-address-bar">
            <span>🔒</span>
            <div class="address-input">http://localhost:5076/Xss</div>
            <span>⚙️</span>
        </div>

        <div class="split-container">
            <!-- Left: Web UI Form -->
            <div class="app-pane">
                <div class="badge bg-danger mb-2">OWASP Top 10 - A03:2021</div>
                <h5 class="fw-bold text-dark">Thực Nghiệm Stored XSS</h5>
                <p class="small text-muted mb-3">Người dùng: Nguyễn Thanh Bình (23A1001D0041)</p>

                <!-- Fake Alert Dialog on Page -->
                <div class="card border-danger shadow mb-3" style="background:#fff3cd; border: 2px solid #ffc107;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="fs-4">⚠️</span>
                            <strong class="text-danger">localhost:5076 cho biết:</strong>
                        </div>
                        <div class="p-2 bg-white rounded border font-monospace text-danger fw-bold small">
                            🚨 BỊ HACK XSS! Đã đọc trộm Session Cookie:<br/>
                            AuthSessionToken=SEC_COOKIE_VIP_TOKEN_998877_SECRET_USER_HOC
                        </div>
                    </div>
                </div>

                <div class="card border-danger shadow-sm mb-3">
                    <div class="card-header bg-danger text-white py-2 small fw-bold">
                        ❌ BÌNH LUẬN CHỨA SCRIPT ĐỘC HẠI ĐÃ LƯU CSDL
                    </div>
                    <div class="card-body p-2 small">
                        <strong>Người gửi:</strong> Hacker_XSS<br/>
                        <strong>Nội dung:</strong> <code>&lt;script&gt;alert(document.cookie)&lt;/script&gt;</code><br/>
                        <span class="badge bg-danger mt-1">Dính lỗi vì View render bằng @@Html.Raw()</span>
                    </div>
                </div>
            </div>

            <!-- Right: DevTools Application & Console -->
            <div class="devtools-pane">
                <div class="dt-header">
                    <div class="dt-tab">Elements</div>
                    <div class="dt-tab active">Console</div>
                    <div class="dt-tab">Sources</div>
                    <div class="dt-tab">Network</div>
                    <div class="dt-tab active">Application (Storage)</div>
                </div>

                <div class="dt-details">
                    <div class="text-muted small mb-1">▼ Application &gt; Cookies &gt; http://localhost:5076</div>
                    <table class="dt-table">
                        <thead>
                            <tr><th>Name</th><th>Value</th><th>Domain</th><th>Path</th><th>HttpOnly</th><th>Secure</th></tr>
                        </thead>
                        <tbody>
                            <tr class="highlight">
                                <td style="color:#8ab4f8; font-weight:bold;">AuthSessionToken</td>
                                <td style="color:#f28b82;">SEC_COOKIE_VIP_TOKEN_99...</td>
                                <td>localhost</td>
                                <td>/</td>
                                <td style="color:#ea4335; font-weight:bold;">✕ false (LỖI)</td>
                                <td>✕ false</td>
                            </tr>
                            <tr>
                                <td>.AspNetCore.Antiforgery</td>
                                <td>CfDJ8N5...</td>
                                <td>localhost</td>
                                <td>/</td>
                                <td>✓ true</td>
                                <td>✓ true</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="text-muted small mt-3 mb-1">▼ Console (Kiểm tra lệnh JavaScript đọc trộm Cookie):</div>
                    <div class="p-2 bg-dark rounded border border-secondary">
                        <div class="console-line">
                            <span class="console-prompt">&gt; document.cookie</span>
                        </div>
                        <div class="console-line">
                            <span class="console-output">&lt; "AuthSessionToken=SEC_COOKIE_VIP_TOKEN_998877_SECRET_USER_HOC"</span>
                        </div>
                        <div class="console-line mt-2" style="color:#9aa0a6;">
                            // Phân tích: Vì cờ HttpOnly = false, mã script độc hại của hacker có quyền<br/>
                            // truy xuất toàn bộ token và gửi ngầm về server của kẻ tấn công (Cookie Stealing).
                        </div>
                    </div>

                    <div class="alert alert-success mt-3 p-2 small" style="background:#132d20; border:1px solid #1e7e34; color:#81c995;">
                        🛡️ <strong>GIẢI PHÁP PHÒNG THỦ:</strong><br/>
                        1. Razor View: Dùng <code>@@comment.Content</code> (tự động HTML Encode)<br/>
                        2. Cookie Options: Bật <code>HttpOnly = true</code> (cấm JavaScript đọc document.cookie)
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
