<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phòng Thí Nghiệm An Toàn Web OWASP (HOU - WNC.G01)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold text-warning" asp-controller="SqlInjection" asp-action="Index">
                    🛡️ OWASP Security Lab (WNC.G01)
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="SqlInjection" asp-action="Index">
                                1. SQL Injection (Học)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Xss" asp-action="Index">
                                2. Stored XSS (Bình)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Csrf" asp-action="Index">
                                3. CSRF (Cường)
                            </a>
                        </li>
                    </ul>
                    <span class="navbar-text text-light small">
                        Học phần: Lập trình Web nâng cao • GVHD: ThS. Lê Hữu Dũng
                    </span>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 bg-white mt-5">
        <div class="container text-center small">
            &copy; 2026 - Khoa CNTT, Đại học Mở Hà Nội (HOU) - Nhóm WNC.G01 (Học - Bình - Cường)
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
